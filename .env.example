# Environment proses mengalahkan nilai di file ini. Restart service setelah perubahan.
SERVER_NAME=
CHECK_INTERVAL=60s
CPU_SAMPLE_DURATION=1s
CPU_THRESHOLD=80
RAM_THRESHOLD=80
DISK_THRESHOLD=85
# Daftar path filesystem dipisahkan koma (bukan device seperti /dev/sda).
DISK_PATHS=/
ALERT_COOLDOWN=30m
REPORT_TIME=06:00
TIMEZONE=Asia/Makassar

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=15s

# Default off; isi bagian berikut hanya jika diaktifkan.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=server_monitor
MYSQL_PASSWORD=
MYSQL_LAG_THRESHOLD=60
MYSQL_TIMEOUT=5s
# false untuk localhost; true untuk TLS dengan verifikasi sertifikat server.
MYSQL_TLS=false
