[Unit]
Description=Server resource and MySQL replication monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=server-monitor
Group=server-monitor
WorkingDirectory=/opt/server-monitor
ExecStart=/opt/server-monitor/bin/service-health-monitor -env /etc/server-monitor/server-monitor.env
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=server-monitor

[Install]
WantedBy=multi-user.target
